<Window x:Class="BlaisePascal.GestoreUdienze.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestore Udienze" Height="850" Width="640"
        WindowStartupLocation="CenterScreen" Background="#f8fafc" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#3b82f6"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e2e8f0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#0f172a"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#ffffff" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                CornerRadius="12" Padding="30" Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="#0f172a" Opacity="0.08" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="TxtFilePath" IsReadOnly="True" Padding="12,0" FontSize="13" 
                                 Text="Seleziona un file..." Background="Transparent" BorderThickness="0" 
                                 Foreground="#64748b" VerticalContentAlignment="Center" MinHeight="42" />
                    </Border>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Sfoglia" Width="100" Margin="12,0,0,0" 
                            Style="{StaticResource PrimaryButton}" MinHeight="42" />
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="#e2e8f0" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="SPECIFICA" Style="{StaticResource SectionLabel}" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Giornata:" FontSize="15" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>

                        <DatePicker x:Name="DatePickerGiornata" Grid.Column="1" Height="42" Margin="0,0,12,0" 
                                    Padding="6,0" VerticalContentAlignment="Center" FontSize="14" 
                                    BorderBrush="#cbd5e1" BorderThickness="1"/>

                        <Button x:Name="BtnStampaGiornata" Grid.Column="2" Content="Stampa" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" MinHeight="42"/>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aule:" FontSize="15" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True">
                            <ListBox x:Name="ListAule" Height="130" Margin="0,0,12,0" SelectionMode="Multiple">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding}" VerticalContentAlignment="Center" Padding="8,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Button x:Name="BtnStampaAule" Grid.Column="2" Content="Stampa" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" MinHeight="42"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Classi:" FontSize="15" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True">
                            <ListBox x:Name="ListClassi" Height="130" Margin="0,0,12,0"/>
                        </Border>
                        <Button x:Name="BtnStampaClassi" Grid.Column="2" Content="Stampa" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" MinHeight="42"/>
                    </Grid>
                </StackPanel>

                <Rectangle Grid.Row="3" Height="1" Fill="#e2e8f0" Margin="0,20,0,20"/>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="GENERALE" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>
                    <Button x:Name="BtnGenera" Content="GENERA" Background="#10b981" FontSize="16" FontWeight="Bold" Height="54" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>