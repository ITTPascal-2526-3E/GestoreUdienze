<Window x:Class="BlaisePascal.GestoreUdienze.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Gestore Udienze" Height="720" Width="620"
    WindowStartupLocation="CenterScreen" Background="#f8fafc" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#3b82f6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563eb"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#3b82f6"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e2e8f0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ImportButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94a3b8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="StepLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#ffffff" MaxWidth="540" VerticalAlignment="Top" HorizontalAlignment="Stretch"
            CornerRadius="12" Padding="40" Margin="40,40,40,0">
            <Border.Effect>
                <DropShadowEffect Color="#0f172a" Opacity="0.08" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock FontSize="26" FontWeight="Bold" 
                           Foreground="#0f172a" HorizontalAlignment="Center" Margin="0,0,0,32">Gestore Udienze</TextBlock>

                <!-- ===== STEP 1: Importa Docenti ===== -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#e0e7ff" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                            <TextBlock Text="1" Foreground="#4f46e5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Importa Docenti" Style="{StaticResource StepLabel}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="TxtFilePathDocenti" IsReadOnly="True" Padding="12,0" FontSize="13" 
                                     Background="Transparent" BorderThickness="0" Foreground="#334155" VerticalContentAlignment="Center" MinHeight="42" />
                        </Border>
                        <Button x:Name="BtnBrowseDocenti" Grid.Column="1" Content="Sfoglia" Width="80" Margin="8,0,0,0" 
                                Style="{StaticResource SecondaryButton}" Click="BtnBrowseDocenti_Click" MinHeight="42" />
                        <Button x:Name="BtnImportaDocenti" Grid.Column="2" Content="Importa Docenti" Width="130" Margin="8,0,0,0" 
                                Style="{StaticResource ImportButton}" Click="BtnImportaDocenti_Click" MinHeight="42" IsEnabled="False" />
                    </Grid>

                    <ProgressBar x:Name="ProgBarDocenti" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,0" 
                                 Foreground="#10b981" Background="#e2e8f0" BorderThickness="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatusDocenti" Text="" FontSize="12" Foreground="#64748b" 
                               HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ===== STEP 2: Importa Aule ===== -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#e0e7ff" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                            <TextBlock Text="2" Foreground="#4f46e5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Importa Aule" Style="{StaticResource StepLabel}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="TxtFilePathAule" IsReadOnly="True" Padding="12,0" FontSize="13" 
                                     Background="Transparent" BorderThickness="0" Foreground="#334155" VerticalContentAlignment="Center" MinHeight="42" />
                        </Border>
                        <Button x:Name="BtnBrowseAule" Grid.Column="1" Content="Sfoglia" Width="80" Margin="8,0,0,0" 
                                Style="{StaticResource SecondaryButton}" Click="BtnBrowseAule_Click" MinHeight="42" />
                        <Button x:Name="BtnImportaAule" Grid.Column="2" Content="Importa Aule" Width="130" Margin="8,0,0,0" 
                                Style="{StaticResource ImportButton}" Click="BtnImportaAule_Click" MinHeight="42" IsEnabled="False" />
                    </Grid>

                    <ProgressBar x:Name="ProgBarAule" Minimum="0" Maximum="100" Height="6" Margin="0,10,0,0" 
                                 Foreground="#10b981" Background="#e2e8f0" BorderThickness="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatusAule" Text="" FontSize="12" Foreground="#64748b" 
                               HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ===== STEP 3: Risultati ===== -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#e0e7ff" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                            <TextBlock Text="3" Foreground="#4f46e5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Risultati" Style="{StaticResource StepLabel}"/>
                    </StackPanel>
                    <Button x:Name="BtnDownload" Content="Scarica Risultati" MinHeight="42" 
                            Style="{StaticResource SecondaryButton}" Click="BtnDownload_Click"/>

                    <ProgressBar x:Name="ProgBarGenerazione" IsIndeterminate="True" Height="8" Margin="0,16,0,0"
                                 Foreground="#22c55e" Background="#e2e8f0" BorderThickness="0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatusGenerazione" Text="Generazione classi in corso..." FontSize="12" Foreground="#64748b"
                               HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>